# General
NODE_ENV=development

# Ports
BACKEND_PORT=4000
SIMULATOR_PORT=4001

# Database (SQLite via Sequelize)
DATABASE_STORAGE=./backend/data/marketplace.sqlite
DATABASE_TEST_STORAGE=:memory:

# Security & Auth (replace with strong random values in local .env)
JWT_SECRET=replace-with-a-strong-random-jwt-secret
JWT_EXPIRES_IN=24h
CORS_ORIGIN=http://localhost:5173

# External Delivery Simulator Integration (EXT)
SIMULATOR_URL=http://localhost:4001
BACKEND_PUBLIC_URL=http://localhost:4000
WEBHOOK_SECRET=replace-with-a-strong-random-webhook-secret
EXTERNAL_TIMEOUT_MS=800
EXTERNAL_MAX_RETRIES=3

# Frontend (Vite)
VITE_API_BASE_URL=/api
VITE_SIMULATOR_URL=http://localhost:4001
